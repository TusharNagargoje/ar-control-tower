// ===== Tables to import (powerbi/data/*.csv): v_invoice_status, dim_client, r_monthly_kpi, c_unbilled, c_unapplied,
// r_credit_util, c_duplicate_invoices, c_gst_mismatch, c_credit_note_exceptions, ml_open_invoice_scores, ai_insights
// Relationships: dim_client[client_id] 1->* on every table with client_id. Add a Date table (CALENDARAUTO()).

Total Billed        = SUM ( v_invoice_status[total] )
Total Outstanding   = SUM ( v_invoice_status[outstanding] )
Overdue AR          = CALCULATE ( [Total Outstanding], v_invoice_status[days_past_due] > 0 )
Overdue %           = DIVIDE ( [Overdue AR], [Total Outstanding] )
AR 90+              = CALCULATE ( [Total Outstanding], v_invoice_status[days_past_due] > 90 )
Collected           = SUM ( r_monthly_kpi[collected] )
Collection Eff %    = DIVIDE ( SUM ( r_monthly_kpi[collected] ), SUM ( r_monthly_kpi[billed] ) )
DSO (days)          = AVERAGE ( r_monthly_kpi[dso_days] )
Unbilled Revenue    = SUM ( c_unbilled[est_total] )
Unapplied Cash      = SUM ( c_unapplied[amount] )
Net AR (after unapplied) = [Total Outstanding] - [Unapplied Cash]
Credit Breach Clients = CALCULATE ( DISTINCTCOUNT ( r_credit_util[client_id] ), r_credit_util[status] = "BREACH" )
Duplicate Overbilled = SUM ( c_duplicate_invoices[overbilled] )
GST Exceptions      = COUNTROWS ( c_gst_mismatch )
CN Exceptions       = COUNTROWS ( c_credit_note_exceptions )
Expected 30d Loss   = SUM ( ml_open_invoice_scores[expected_loss_30d] )
Control Score       = 100 - 100 * DIVIDE ( [GST Exceptions] + [CN Exceptions] + COUNTROWS ( c_duplicate_invoices ),
                                           DISTINCTCOUNT ( v_invoice_status[invoice_id] ) ) * 10
MoM Billed %        = VAR cur = [Total Billed]
                      VAR prev = CALCULATE ( [Total Billed], DATEADD ( 'Date'[Date], -1, MONTH ) )
                      RETURN DIVIDE ( cur - prev, prev )
// Field parameter for metric switcher (Insert > New parameter > Fields): Total Outstanding, Overdue AR, AR 90+, Expected 30d Loss
